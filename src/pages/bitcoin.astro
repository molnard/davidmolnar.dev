---
import CompetencyPage from '../components/CompetencyPage.astro';
import { contact } from '../config/contact';
import { useTranslations } from '../i18n/utils';
const t = useTranslations('en');
---
<CompetencyPage
  lang="en"
  competency="bitcoin"
  title={`${t('comp.bitcoin.title')} — David Molnar`}
  description={t('comp.bitcoin.short')}
  detail={t('comp.bitcoin.detail')}
  tag={t('comp.bitcoin.tag')}
  image="/images/competencies/bitcoin.webp"
  fallbackClass="bg-c-btc"
  altHref="/hu/bitcoin/"
>
  <section slot="extra" class="bg-paper border-t border-ink/5">
    <div class="max-w-3xl mx-auto px-6 md:px-8 py-16 md:py-20">
      <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight text-ink mb-8">Development areas</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-10">
        <div><h3 class="font-semibold text-forest mb-3">Applications and backend systems</h3>
          <ul class="space-y-2 text-muted leading-relaxed"><li>Desktop clients built with C# and .NET</li><li>Server-side services and APIs</li><li>Protocol integration and connected components</li><li>Databases and network communication</li></ul></div>
        <div><h3 class="font-semibold text-forest mb-3">Open-source collaboration</h3>
          <ul class="space-y-2 text-muted leading-relaxed"><li>Understanding and extending existing codebases</li><li>Debugging and verifiable fixes</li><li>Code review and automated testing</li><li>Privacy considerations in system architecture</li></ul></div>
      </div>
      <p class="text-muted leading-relaxed mt-10">You can explore my public work on <a class="text-forest underline underline-offset-4" href={contact.github} target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
    </div>
  </section>
</CompetencyPage>

<style>
  .bg-c-btc {
    background:
      radial-gradient(circle at 30% 70%, #F7931A 0%, transparent 45%),
      radial-gradient(circle at 70% 30%, #4A1F00 0%, transparent 50%),
      linear-gradient(135deg, #2A1100 0%, #5C2D00 100%);
  }
</style>
