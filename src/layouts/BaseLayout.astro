---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  altHref?: string;
}

const { title, description, altHref: altHrefProp } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const altLang: Lang = lang === 'en' ? 'hu' : 'en';
const altHref = altHrefProp ?? (altLang === 'en' ? '/' : '/hu/');
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const currentPath = Astro.url.pathname;
const enPath = lang === 'hu'
  ? currentPath.replace(/^\/hu(?=\/|$)/, '') || '/'
  : currentPath;
const huPath = lang === 'hu'
  ? currentPath
  : currentPath === '/' ? '/hu/' : `/hu${currentPath}`;
const ogImage = new URL('/og.png', Astro.site).toString();

const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).toString()} />
    <link rel="alternate" hreflang="hu" href={new URL(huPath, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Language auto-detect: runs before paint to avoid flash -->
    <script is:inline define:vars={{ lang, altHref }}>
      (function () {
        var stored = localStorage.getItem('lang');
        var target;
        if (stored === 'en' || stored === 'hu') {
          target = stored;
        } else {
          var bl = (navigator.language || '').toLowerCase();
          target = bl.startsWith('hu') ? 'hu' : 'en';
        }
        if (target !== lang) {
          window.location.replace(altHref);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans antialiased selection:bg-forest selection:text-paper">
    <Header lang={lang} altLang={altLang} altHref={altHref} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Save language preference when user manually switches -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-lang-switch]');
        if (el) localStorage.setItem('lang', el.dataset.langSwitch);
      });
    </script>

    <!-- YouTube is loaded only after an explicit visitor action. -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var button = e.target.closest('[data-privacy-video-load]');
        if (!button) return;

        var container = button.closest('[data-privacy-video]');
        if (!container) return;

        var videoId = container.dataset.videoId || '';
        if (!/^[A-Za-z0-9_-]{11}$/.test(videoId)) return;

        var start = Number.parseInt(container.dataset.videoStart || '', 10);
        var params = new URLSearchParams({ autoplay: '1', rel: '0' });
        if (Number.isFinite(start) && start > 0) params.set('start', String(start));

        var iframe = document.createElement('iframe');
        iframe.className = 'privacy-video__iframe';
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?' + params.toString();
        iframe.title = container.dataset.videoTitle || 'YouTube video';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer';

        container.replaceChildren(iframe);
      });
    </script>

    {isProd && cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      />
    )}
  </body>
</html>
