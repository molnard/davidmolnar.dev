---
import '../styles/global.css';
import '../styles/contact.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, type Lang } from '../i18n/utils';
import { contact } from '../config/contact';

interface Props {
  title: string;
  description: string;
  altHref?: string;
  noindex?: boolean;
}

const { title, description, altHref: altHrefProp, noindex = false } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const altLang: Lang = lang === 'en' ? 'hu' : 'en';
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const currentPath = Astro.url.pathname;
const enPath = lang === 'hu'
  ? currentPath.replace(/^\/hu(?=\/|$)/, '') || '/'
  : currentPath;
const huPath = lang === 'hu'
  ? currentPath
  : currentPath === '/' ? '/hu/' : `/hu${currentPath}`;
const ogImage = new URL('/og.png', Astro.site).toString();
const altHref = altHrefProp ?? (altLang === 'en' ? enPath : huPath);

const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const isProd = import.meta.env.PROD && import.meta.env.PUBLIC_ENABLE_ANALYTICS === 'true';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).toString()} />
    <link rel="alternate" hreflang="hu" href={new URL(huPath, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1733" />
    <meta property="og:image:height" content="908" />
    <meta property="og:image:alt" content={`${contact.name[lang]} — ${contact.role[lang]}`} />
    <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    {currentPath === '/' && !noindex && <script is:inline>
      // Explicit language paths win; only the entry page uses the saved preference.
      try {
        var preferred = localStorage.getItem('lang');
        if (!preferred) preferred = (navigator.language || '').startsWith('hu') ? 'hu' : 'en';
        if (preferred === 'hu') location.replace('/hu/' + location.search + location.hash);
      } catch (_) {}
    </script>}

  </head>
  <body class="min-h-screen bg-paper text-ink font-sans antialiased selection:bg-forest selection:text-paper">
    <a class="skip-link" href="#main">{lang === 'hu' ? 'Ugrás a tartalomra' : 'Skip to content'}</a>
    <Header lang={lang} altHref={altHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <p id="copy-status" class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>

    <script is:inline>
      document.addEventListener('click', function (event) {
        var el = event.target instanceof Element && event.target.closest('[data-lang-switch]');
        if (!el) return;
        try { localStorage.setItem('lang', el.dataset.langSwitch); } catch (_) {}
        if (location.hash) el.hash = location.hash;
      });
    </script>
    <script>
      import '../scripts/copy';
    </script>

    {isProd && cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      />
    )}
  </body>
</html>
