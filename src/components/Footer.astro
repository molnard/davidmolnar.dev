---
import { useTranslations, type Lang } from '../i18n/utils';
import { contact } from '../config/contact';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const bitcoinAcceptedHref = lang === 'hu' ? '/hu/bitcoin-accepted/' : '/bitcoin-accepted/';
const privacyHref = lang === 'hu' ? '/hu/privacy/' : '/privacy/';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-identity">
      <span class="footer-name">© {year} {contact.name[lang]}</span>
      <span class="footer-legal">{t('footer.legal')}</span>
    </div>
    <nav class="footer-links" aria-label={lang === 'hu' ? 'További információ' : 'Further information'}>
      <a href={privacyHref}>{t('footer.privacy')}</a>
      <a href={bitcoinAcceptedHref}>{lang === 'hu' ? 'Bitcoin-fizetés' : 'Bitcoin payments'}</a>
      <a href="https://github.com/molnard/davidmolnar.dev" target="_blank" rel="noopener noreferrer">{lang === 'hu' ? 'Forráskód' : 'Source code'} ↗</a>
    </nav>
  </div>
</footer>
