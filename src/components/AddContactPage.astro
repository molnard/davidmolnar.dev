---
import '../styles/global.css';

type Lang = 'en' | 'hu';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  en: {
    htmlLang: 'en',
    description: 'David Molnar contact page. Save contact details to your phone from a vCard file.',
    ogTitle: 'David Molnar contact card',
    ogDescription: 'David Molnar contact details and downloadable vCard contact file.',
    title: 'David Molnar contact card',
    label: 'Contact card',
    prompt: 'Tap the button to save this contact to your phone.',
    save: 'Add contact',
    phone: 'Phone',
    address: 'Address',
    call: 'Call',
    website: 'Website',
  },
  hu: {
    htmlLang: 'hu',
    description: 'Molnár Dávid névjegyoldala. Névjegy mentése telefonra vCard fájlból.',
    ogTitle: 'Molnár Dávid névjegye',
    ogDescription: 'Molnár Dávid elérhetőségei és letölthető vCard névjegye.',
    title: 'Molnár Dávid névjegye',
    label: 'Névjegy',
    prompt: 'A névjegy mentéséhez még nyomd meg a gombot.',
    save: 'Névjegy hozzáadása',
    phone: 'Telefon',
    address: 'Cím',
    call: 'Hívás',
    website: 'Weboldal',
  },
} as const;

const t = content[lang];
const canonicalPath = lang === 'hu' ? '/hu/addcontact' : '/addcontact';
const canonicalURL = new URL(canonicalPath, Astro.site).toString();
const huContactPath = '/hu/addcontact';
const siteURL = new URL('/', Astro.site).toString();
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t.description} />
    <meta name="robots" content="noindex, noarchive, nosnippet" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={new URL('/addcontact', Astro.site).toString()} />
    <link rel="alternate" hreflang="hu" href={new URL('/hu/addcontact', Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL('/addcontact', Astro.site).toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={t.ogTitle} />
    <meta property="og:description" content={t.ogDescription} />
    {lang === 'en' && (
      <script is:inline define:vars={{ huContactPath }}>
        (function () {
          var browserLanguage = (navigator.language || '').toLowerCase();
          if (browserLanguage === 'hu' || browserLanguage.startsWith('hu-')) {
            window.location.replace(huContactPath);
          }
        })();
      </script>
    )}
    <title>{t.title}</title>
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans antialiased">
    <main class="min-h-screen px-5 py-6 flex justify-center">
      <section class="w-full max-w-md">
        <div class="mb-5 flex items-center gap-4">
          <img
            src="/images/david-molnar-contact.jpg"
            alt="Molnár Dávid"
            width="160"
            height="160"
            class="size-20 shrink-0 rounded-full object-cover ring-4 ring-cream"
          />
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-forest">{t.label}</p>
            <h1 class="mt-2 font-display text-3xl font-semibold text-ink">Molnár Dávid</h1>
            <p class="mt-1 text-muted">davidmolnar.dev</p>
          </div>
        </div>

        <div class="mb-6 rounded-md border border-amber/50 bg-cream p-4">
          <p class="text-sm font-semibold text-ink">{t.prompt}</p>
          <a
            href="/contact.vcf"
            download="Molnar-David.vcf"
            class="save-contact-button mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-md bg-forest px-5 py-3 text-center font-semibold text-paper transition-colors hover:bg-forest-dark focus:outline-none focus:ring-2 focus:ring-forest focus:ring-offset-2 focus:ring-offset-cream"
          >
            {t.save}
          </a>
        </div>

        <dl class="divide-y divide-ink/10 border-y border-ink/10">
          <div class="py-4">
            <dt class="text-xs font-medium uppercase tracking-wide text-muted">Email</dt>
            <dd class="mt-1 text-lg">
              <a class="text-forest hover:text-forest-dark" href="mailto:hello@davidmolnar.dev">
                hello@davidmolnar.dev
              </a>
            </dd>
          </div>
          <div class="py-4">
            <dt class="text-xs font-medium uppercase tracking-wide text-muted">{t.phone}</dt>
            <dd class="mt-1 text-lg">
              <a class="text-forest hover:text-forest-dark" href="tel:+36705950579">
                +36 70 595 0579
              </a>
            </dd>
          </div>
          <div class="py-4">
            <dt class="text-xs font-medium uppercase tracking-wide text-muted">{t.address}</dt>
            <dd class="mt-1 text-lg"></dd>
          </div>
        </dl>

        <div class="mt-7 grid gap-3">
          <div class="grid grid-cols-3 gap-2">
            <a
              class="inline-flex min-h-11 items-center justify-center rounded-md border border-ink/15 px-3 text-sm font-medium text-ink transition-colors hover:border-forest hover:text-forest"
              href="tel:+36705950579"
            >
              {t.call}
            </a>
            <a
              class="inline-flex min-h-11 items-center justify-center rounded-md border border-ink/15 px-3 text-sm font-medium text-ink transition-colors hover:border-forest hover:text-forest"
              href="mailto:hello@davidmolnar.dev"
            >
              Email
            </a>
            <a
              class="inline-flex min-h-11 items-center justify-center rounded-md border border-ink/15 px-3 text-sm font-medium text-ink transition-colors hover:border-forest hover:text-forest"
              href={siteURL}
            >
              {t.website}
            </a>
          </div>
        </div>
      </section>
    </main>

    <style>
      .save-contact-button {
        animation: cta-pulse 1.8s ease-in-out infinite;
        box-shadow: 0 0 0 0 rgba(31, 58, 46, 0.42), 0 10px 24px rgba(31, 58, 46, 0.18);
      }

      .save-contact-button:hover,
      .save-contact-button:focus-visible {
        animation: none;
      }

      @keyframes cta-pulse {
        0% {
          transform: translateY(0) scale(1);
          box-shadow: 0 0 0 0 rgba(31, 58, 46, 0.42), 0 10px 24px rgba(31, 58, 46, 0.18);
        }
        35% {
          transform: translateY(-3px) scale(1.035);
          box-shadow: 0 0 0 12px rgba(31, 58, 46, 0), 0 16px 30px rgba(31, 58, 46, 0.24);
        }
        50% {
          transform: translateY(0) scale(0.995);
          box-shadow: 0 0 0 0 rgba(31, 58, 46, 0), 0 8px 18px rgba(31, 58, 46, 0.16);
        }
        70% {
          transform: translateY(-2px) scale(1.02);
          box-shadow: 0 0 0 8px rgba(31, 58, 46, 0), 0 14px 26px rgba(31, 58, 46, 0.2);
        }
        100% {
          transform: translateY(0) scale(1);
          box-shadow: 0 0 0 0 rgba(31, 58, 46, 0.42), 0 10px 24px rgba(31, 58, 46, 0.18);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .save-contact-button {
          animation: none;
        }
      }
    </style>
  </body>
</html>
