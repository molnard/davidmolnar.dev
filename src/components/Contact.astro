---
import type { Lang } from '../i18n/utils';
import { contact } from '../config/contact';
import Icon from './Icon.astro';
import CopyButton from './CopyButton.astro';
interface Props { lang: Lang; standalone?: boolean; }
const { lang, standalone = false } = Astro.props;
const t = lang === 'hu' ? {
  title: 'Kapcsolat', reveal: 'Email-cím megjelenítése', write: 'Email írása',
  booking: 'Időpontfoglalás · 30 perc', extra: 'További elérhetőségek',
  copyEmail: 'Email-cím másolása', copyNostr: 'Nostr-azonosító másolása', copyPgp: 'PGP-ujjlenyomat másolása',
  pgp: 'Nyilvános PGP-kulcs', qr: 'Signal QR-kód', close: 'Bezárás',
  qrHint: 'Olvasd be a telefonoddal, vagy nyisd meg a Signal-profilt.', openSignal: 'Megnyitás Signalban',
} : {
  title: 'Contact', reveal: 'Show email address', write: 'Write an email',
  booking: 'Book a call · 30 min', extra: 'More ways to connect',
  copyEmail: 'Copy email address', copyNostr: 'Copy Nostr identifier', copyPgp: 'Copy PGP fingerprint',
  pgp: 'Public PGP key', qr: 'Signal QR code', close: 'Close',
  qrHint: 'Scan with your phone, or open the Signal profile.', openSignal: 'Open in Signal',
};
---
<section id="contact" class:list={['contact-panel', { 'contact-standalone': standalone }]} aria-labelledby="contact-title">
  <h2 id="contact-title">{t.title}</h2>
  <details class="email-reveal">
    <summary class="button button-amber"><Icon name="mail" />{t.reveal}</summary>
    <div class="email-content">
      <div class="email-actions">
        <a class="email-address" href={`mailto:${contact.email}`} aria-label={`${t.write}: ${contact.email}`}>{contact.email}</a>
        <CopyButton value={contact.email} label={t.copyEmail} {lang} />
      </div>
    </div>
  </details>
  <a class="button button-outline booking-link" href={contact.calendly} target="_blank" rel="noopener noreferrer"><Icon name="calendar" />{t.booking}</a>
  <div class="messengers">
    <a href={contact.signal} target="_blank" rel="noopener noreferrer"><Icon name="message" />Signal</a>
    <a href={contact.signalQr} class="qr-trigger" data-open-qr aria-label={t.qr}><Icon name="qr" />{lang === 'hu' ? 'QR-kód' : 'QR code'}</a>
    <a href={contact.telegram} target="_blank" rel="noopener noreferrer"><Icon name="telegram" />Telegram</a>
  </div>
  <details class="extra-contact">
    <summary>{t.extra}<Icon name="chevron" /></summary>
    <div class="extra-contact-content">
      <div class="contact-identifier"><h3>Nostr</h3><p>{contact.nostr}</p><CopyButton value={contact.nostr} label={t.copyNostr} {lang} /></div>
      <div class="contact-identifier"><h3>PGP</h3><p>{contact.pgpFingerprint}</p><a href={contact.pgpKey}>{t.pgp}</a><CopyButton value={contact.pgpFingerprint.replace(/\s/g, '')} label={t.copyPgp} {lang} /></div>
    </div>
  </details>
</section>
<dialog class="qr-dialog" aria-labelledby="qr-title" data-qr-dialog>
  <button type="button" class="dialog-close" data-close-qr aria-label={t.close}><Icon name="close" /></button>
  <h2 id="qr-title">{t.qr}</h2>
  <p>{t.qrHint}</p>
  <div class="qr-artwork"><img src={contact.signalQr} alt={`Signal: ${contact.signalName}`} width="1272" height="1728" loading="lazy" /></div>
  <a class="button button-forest" href={contact.signal} target="_blank" rel="noopener noreferrer">{t.openSignal}</a>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-qr-dialog]');
  const trigger = document.querySelector<HTMLAnchorElement>('[data-open-qr]');
  trigger?.addEventListener('click', event => {
    if (!dialog || typeof dialog.showModal !== 'function') return;
    event.preventDefault();
    dialog.showModal();
  });
  document.querySelector('[data-close-qr]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', event => {
    if (event.target !== dialog) return;
    const bounds = dialog.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
  });
  dialog?.addEventListener('close', () => trigger?.focus());
</script>
