---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const personalActivitySource =
  'https://github.com/ashkulz/committers.top/blob/6bf669e3e9db0bcf665f55eab2815691c7963352/_data/locations/hungary.yml#L77-L83';
const globalBenchmarkSource =
  'https://github.com/ashkulz/committers.top/blob/6bf669e3e9db0bcf665f55eab2815691c7963352/_data/locations/worldwide.yml#L197-L212';
---

<section class="border-y border-ink/10 bg-cream" aria-label={t('proof.aria')}>
  <div class="mx-auto max-w-6xl px-6 md:px-8">
    <ul class="grid divide-y divide-ink/10 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <li class="py-7 sm:py-9 sm:pr-8">
        <p class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
          {t('proof.experience.value')}
        </p>
        <p class="mt-2 text-sm font-medium text-ink">
          {t('proof.experience.label')}
        </p>
        <p class="mt-1 font-mono text-[10px] uppercase tracking-widest text-muted/70">
          {t('proof.experience.meta')}
        </p>
      </li>

      <li class="py-7 sm:px-8 sm:py-9">
        <p class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
          {t('proof.wasabi.value')}
        </p>
        <p class="mt-2 text-sm font-medium text-ink">
          {t('proof.wasabi.label')}
        </p>
        <p class="mt-1 font-mono text-[10px] uppercase tracking-widest text-muted/70">
          {t('proof.wasabi.meta')}
        </p>
      </li>

      <li class="sm:pl-8">
        <div class="-mx-3 flex h-full flex-col justify-center px-3 py-7 sm:mx-0 sm:-mr-3 sm:px-3 sm:py-9">
          <span class="font-display text-3xl font-semibold tracking-tight text-forest md:text-4xl">
            {t('proof.github.value')}
          </span>
          <span class="mt-2 text-sm font-medium text-ink">
            {t('proof.github.label')}
          </span>
          <span class="mt-1 font-mono text-[10px] uppercase tracking-widest text-muted/70">
            {t('proof.github.meta')}
          </span>
          <span class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">
            <a
              href={personalActivitySource}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-ink/20 underline-offset-4 hover:text-forest"
            >
              {t('proof.github.source.personal')} ↗
            </a>
            <a
              href={globalBenchmarkSource}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-ink/20 underline-offset-4 hover:text-forest"
            >
              {t('proof.github.source.benchmark')} ↗
            </a>
          </span>
        </div>
      </li>
    </ul>
  </div>
</section>
