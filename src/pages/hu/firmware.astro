---
import CompetencyPage from '../../components/CompetencyPage.astro';
import { useTranslations } from '../../i18n/utils';
const t = useTranslations('hu');
---
<CompetencyPage
  lang="hu"
  competency="firmware"
  title={`${t('comp.firmware.title')} — Molnár Dávid`}
  description="ESP32, STM32, Atmel, nRF52. Akkumulátoros kézi eszközök, Bluetooth, kijelzők, hang. Egyedi firmware PCB kapcsolási rajztól."
  detail={t('comp.firmware.detail')}
  tag={t('comp.firmware.tag')}
  image="/images/competencies/firmware.webp"
  fallbackClass="bg-c-fw"
  altHref="/firmware/"
>
  <section slot="extra" class="bg-paper border-t border-ink/5">
    <div class="max-w-3xl mx-auto px-6 md:px-8 py-16 md:py-20">

      <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight text-ink mb-6">Hogyan dolgozom</h2>
      <p class="text-muted text-base leading-relaxed mb-16">
        A leghasznosabb akkor vagyok, ha korán bevonnak — ideálisan még a PCB véglegesítése előtt. Szorosan együttdolgozom a villamosmérnökkel a kapcsolási rajzon, firmware-t írok nulláról vagy adaptálom a meglévő kódot, kezelem a perifériák integrációját (kijelzők, BLE modulok, hang, szenzorok), és megépítem a teszteléshez és kalibrációhoz szükséges szoftvereszközöket. Rendszeresen végeztem közvetlen ügyfélegyeztetést is: igényfelmérés, műszaki egyeztetések és technikai átadás — a fejlesztőcsapat és a végfelhasználók számára. Teljes projektmenedzsmentet is vállalok, ha szükséges.
      </p>

      <!-- Stack -->
      <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight text-ink mb-8">Stack</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-6 mb-16">
        <div>
          <h3 class="font-mono text-[11px] uppercase tracking-widest text-amber-dark mb-3">Mikrokontrollerek</h3>
          <ul class="space-y-1.5 text-muted text-sm leading-relaxed">
            <li>STM32 — Atollic TrueSTUDIO, HAL</li>
            <li>Atmel (AVR, SAM)</li>
            <li>ESP32 — Wi-Fi, BLE</li>
            <li>nRF52 — BLE</li>
          </ul>
        </div>
        <div>
          <h3 class="font-mono text-[11px] uppercase tracking-widest text-amber-dark mb-3">Perifériák</h3>
          <ul class="space-y-1.5 text-muted text-sm leading-relaxed">
            <li>Bluetooth / BLE modulok</li>
            <li>Érintőképernyő és kijelzővezérlők</li>
            <li>MP3 chip, hangkimenet</li>
            <li>SD kártya tárolás</li>
            <li>Akkumulátorkezelés</li>
          </ul>
        </div>
        <div>
          <h3 class="font-mono text-[11px] uppercase tracking-widest text-amber-dark mb-3">Hardver</h3>
          <ul class="space-y-1.5 text-muted text-sm leading-relaxed">
            <li>PCB tervezés — EAGLE, Altium</li>
            <li>Prototípusépítés és tesztpados ellenőrzés</li>
            <li>Gyártási folyamat támogatása</li>
          </ul>
        </div>
      </div>

    </div>
  </section>
</CompetencyPage>

<style>
  .bg-c-fw {
    background:
      radial-gradient(circle at 50% 50%, rgba(232,163,60,0.12) 0%, transparent 60%),
      linear-gradient(135deg, #0F2A1F 0%, #1F4A35 100%);
  }
</style>
