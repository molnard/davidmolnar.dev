---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/utils';

type CompetencyKey = 'bitcoin' | 'software' | 'firmware' | 'smarthome';

interface Props {
  lang: Lang;
  competency: CompetencyKey;
  title: string;
  description: string;
  detail: string;
  tag: string;
  image?: string;
  fallbackClass: string;
  altHref: string;
}

const { lang, competency, title, description, detail, tag, image, fallbackClass, altHref } = Astro.props;
const t = useTranslations(lang);
const heading = t(`comp.${competency}.title`);

---

<BaseLayout {title} {description} {altHref}>
  <!-- Hero -->
  <div class={`relative w-full min-h-[320px] md:min-h-[360px] overflow-hidden ${!image ? fallbackClass : ''}`}>
    {image && (
      <img
        src={image}
        alt={t(`comp.${competency}.alt`)}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-[#0F1A14]/80 via-[#0F1A14]/30 to-transparent"></div>
    <div class="relative min-h-[320px] md:min-h-[360px] flex flex-col justify-end p-8 md:p-14 max-w-6xl mx-auto w-full">
      <a href={lang === 'hu' ? '/hu/' : '/'} class="font-mono text-[11px] uppercase tracking-widest text-paper/85 hover:text-paper transition-colors mb-4 inline-block">{t('comp.page.back')}</a>
      <span class="font-mono text-[10px] uppercase tracking-widest text-amber mb-3">{tag}</span>
      <h1 class="font-display font-bold text-3xl md:text-5xl tracking-tight text-paper">{heading}</h1>
    </div>
  </div>

  <!-- Detail -->
  <section class="bg-paper">
    <div class="max-w-3xl mx-auto px-6 md:px-8 py-16 md:py-24">
      <slot name="detail">
        <p class="text-lg md:text-xl leading-relaxed text-muted">{detail}</p>
      </slot>
    </div>
  </section>

  <!-- Extra slot (optional per-page content) -->
  <slot name="extra" />

</BaseLayout>
