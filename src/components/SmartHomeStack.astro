---
import type { Lang } from '../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const groups = [
  { title: lang === 'hu' ? 'Platformok' : 'Platforms', items: ['Home Assistant', 'Homey', 'Loxone', 'Aqara Hub'] },
  { title: lang === 'hu' ? 'Fejlesztés és kommunikáció' : 'Development and communication', items: ['ESP32', 'KNX', 'Zigbee', 'Wi-Fi / Bluetooth LE'] },
  { title: lang === 'hu' ? 'Eszközök és márkák' : 'Devices and brands', items: ['Aqara', 'SONOFF', 'Shelly', 'Philips Hue', 'IKEA Home smart', 'SwitchBot'] },
  { title: lang === 'hu' ? 'Hálózatok' : 'Networking', items: ['TP-Link Omada', 'Ubiquiti UniFi'] },
];
---
<section class="bg-paper border-t border-ink/5">
  <div class="max-w-3xl mx-auto px-6 md:px-8 py-16 md:py-20">
    <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight text-ink mb-8">Stack</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-6">
      {groups.map(group => (
        <div>
          <h3 class="font-mono text-[11px] uppercase tracking-widest text-amber-dark mb-3">{group.title}</h3>
          <ul class="space-y-1.5 text-muted text-sm leading-relaxed">
            {group.items.map(item => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
