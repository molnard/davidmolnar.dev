---
import CompetencyPage from '../../components/CompetencyPage.astro';
import { contact } from '../../config/contact';
import { useTranslations } from '../../i18n/utils';
const t = useTranslations('hu');
---
<CompetencyPage
  lang="hu"
  competency="bitcoin"
  title={`${t('comp.bitcoin.title')} — Molnár Dávid`}
  description={t('comp.bitcoin.short')}
  detail={t('comp.bitcoin.detail')}
  tag={t('comp.bitcoin.tag')}
  image="/images/competencies/bitcoin.webp"
  fallbackClass="bg-c-btc"
  altHref="/bitcoin/"
>
  <section slot="extra" class="bg-paper border-t border-ink/5">
    <div class="max-w-3xl mx-auto px-6 md:px-8 py-16 md:py-20">
      <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight text-ink mb-8">Fejlesztési területek</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-10">
        <div><h3 class="font-semibold text-forest mb-3">Alkalmazások és háttérrendszerek</h3>
          <ul class="space-y-2 text-muted leading-relaxed"><li>Asztali kliensalkalmazások C# és .NET környezetben</li><li>Szerveroldali szolgáltatások és API-k</li><li>Protokollok integrálása és komponensek összekapcsolása</li><li>Adatbázisok és hálózati kommunikáció</li></ul></div>
        <div><h3 class="font-semibold text-forest mb-3">Nyílt forráskódú együttműködés</h3>
          <ul class="space-y-2 text-muted leading-relaxed"><li>Meglévő kódbázisok megértése és továbbfejlesztése</li><li>Hibakeresés és ellenőrizhető javítások</li><li>Kódellenőrzés és automatizált tesztelés</li><li>Adatvédelmi szempontok az architektúrában</li></ul></div>
      </div>
      <p class="text-muted leading-relaxed mt-10">Nyilvános szakmai munkáim a <a class="text-forest underline underline-offset-4" href={contact.github} target="_blank" rel="noopener noreferrer">GitHub-profilomon</a> követhetők.</p>
    </div>
  </section>
</CompetencyPage>

<style>
  .bg-c-btc {
    background:
      radial-gradient(circle at 30% 70%, #F7931A 0%, transparent 45%),
      radial-gradient(circle at 70% 30%, #4A1F00 0%, transparent 50%),
      linear-gradient(135deg, #2A1100 0%, #5C2D00 100%);
  }
</style>
