---
import type { Lang } from '../i18n/utils';
import { payments } from '../config/contact';
import CopyButton from './CopyButton.astro';
import Icon from './Icon.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const hu = lang === 'hu';
const methods = [
  { title: 'Bitcoin', value: payments.bitcoin, qr: '/images/bitcoin-address-qr.png',
    description: hu ? 'Hagyományos on-chain Bitcoin-fizetéshez használd az alábbi címet vagy a QR-kódot.' : 'Use the address below or scan the QR code for a standard on-chain Bitcoin payment.' },
  { title: 'Silent Payments', value: payments.silent, qr: '/images/silent-payment-qr.png',
    description: hu ? 'Silent Payments fizetéshez használd az alábbi címet egy kompatibilis tárcából.' : 'Use this address from a compatible wallet for a Silent Payments transaction.' },
  { title: 'Lightning', value: payments.lightning, qr: null,
    description: hu ? 'Lightningon az alábbi címen vagyok elérhető.' : 'You can reach me on Lightning at the address below.' },
];
---
<section class="document-layout shell">
  <h1>{hu ? 'Bitcoin-fizetés' : 'Bitcoin payments'}</h1>
  <p class="document-intro">{hu ? 'Bitcoin, Silent Payments és Lightning elérhetőségeim.' : 'My Bitcoin, Silent Payments and Lightning payment details.'}</p>
  {methods.map(method => (
    <section class="payment-option" aria-label={method.title}>
      <h2>{method.title}</h2>
      <p>{method.description}</p>
      <code class="payment-address">{method.value}</code>
      <CopyButton value={method.value} label={`${method.title} ${hu ? 'cím másolása' : 'address: copy'}`} {lang} />
      {method.qr && <details class="payment-qr">
        <summary><Icon name="qr" />{hu ? 'QR-kód megjelenítése' : 'Show QR code'}<Icon name="chevron" /></summary>
        <img src={method.qr} alt={`${method.title} ${hu ? 'cím QR-kódja' : 'address QR code'}`} loading="lazy" />
      </details>}
    </section>
  ))}
  <a class="back-link" href={hu ? '/hu/' : '/'}>{hu ? 'Vissza a főoldalra' : 'Back to the homepage'}</a>
</section>
